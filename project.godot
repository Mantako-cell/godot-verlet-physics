; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Verlet Dynamics (2D & 3D) - Showcase"
run/main_scene="res://demo/scenes/showcase_world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://addons/verlet_dynamics_3d/icons/icon_rope.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/verlet_dynamics_3d/plugin.cfg")

[display]

window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
