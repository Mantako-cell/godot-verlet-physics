; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can also make subtle tweaks here.

config_version=5

[application]

config/name="Verlet Dynamics 3D - Showcase"
run/main_scene="res://demo/scenes/showcase_world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://addons/verlet_dynamics_3d/icons/icon_rope.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/verlet_dynamics_3d/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
