; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can also make subtle tweaks here.

config_version=5

[application]

config/name="Verlet Dynamics (2D & 3D) - Showcase"
run/main_scene="res://demo/scenes/showcase_world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://addons/verlet_dynamics_3d/icons/icon_rope.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/verlet_dynamics_3d/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
