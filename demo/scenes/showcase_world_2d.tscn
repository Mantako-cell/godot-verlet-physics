[node name="Instructions" type="Label" parent="HUD/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.25, 0.35, 1)
text = "2D Physics Controls:
• Left-Mouse Click & Drag: Grab and pull any ragdoll limb, rope, slime, or banner
• Click & Drag on Terrain (Y > 500): Indent/crater soil or generate radiating wave ripples
• 'M' or Terrain Button: Toggle Terrain Mode (Deformable Earth / Fluid Basin)
• 'X': Smooth / level terrain | 'Z': Drop ragdoll | Space or 'B': Drop rolling ball
• Right-Mouse Click or 'C': Cut rope segment or tear banner under cursor
• 'W': Toggle wind blower | 'T': Toggle Tension stress heatmap
• 'R': Reset scene | Click 'Switch to 3D Playground' to return to 3D mode"


