[node name="Instructions" type="Label" parent="HUD/PauseMenu/CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 0.85)
theme_override_font_sizes/font_size = 13
text = "• Right-Mouse Drag: Orbit / Fly Camera
• Left-Mouse Click & Drag: Grab & stretch any rope/cloth particle in 3D
• 'G' / Grapple Button: Shoot physics grappling hook rope (Mouse Wheel to winch)
• 'C' or Middle-Mouse: Laser slice ropes or tear cloth with spark burst FX
• 'T': Toggle real-time Tension Heatmap | 'W': Cycle Wind (Gale / Vortex / Off)
• 'B' or Space: Fire rolling physics sphere | 'P': Toggle quality profile
• 'R': Reset scene | '2': Switch to 2D playground | 'ESC': Pause / Resume"
